      "description": "Preserves HTML datetime attributes during web extraction.",
      "validation": [
        "GitHub release timestamps remain available to extraction pipeline"
      ]
    }
  ],
  "artifacts": {
    "source_patch": "frontend/Chat.svelte.setDefaults-race.patch",
    "deployment_frontend": "frontend/BLLL3FN7.js.patched",
    "deployment_backend": "backend/utils.py.patched"
  },
  "integrity": {
    "manifest": "SHA256SUMS"
  }
